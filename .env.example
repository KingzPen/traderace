# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# ─── Supabase (Auth + Database) ──────────────────────────────────────────────
# Create project at https://supabase.com
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── MetaAPI (MT5/MT4 cloud connector) ───────────────────────────────────────
# Sign up at https://metaapi.cloud — free tier available
# This is what enables the investor password MT5 connection from the cloud
METAAPI_TOKEN=your-metaapi-token

# ─── Twelve Data (Live price feed) ───────────────────────────────────────────
# Sign up at https://twelvedata.com — free tier: 800 calls/day
TWELVE_DATA_API_KEY=your-twelve-data-key

# ─── Stripe (Subscriptions) ──────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_your-stripe-key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
STRIPE_PRO_PRICE_ID=price_your-pro-price-id
STRIPE_PROP_PRICE_ID=price_your-prop-price-id
